# ==============================================================================
# Kishi Example Environment Configuration
# ==============================================================================
# Copy or export these variables in your environment before running Kishi.
# NEVER commit real secrets, database passwords, or .env files to Git.
#
# Note:
# - The Spring Boot backend reads DB_* and JWT_* from OS/shell environment
#   variables (e.g., `set -a && source .env && set +a` before `mvn spring-boot:run`),
#   or via an ignored `Backend/src/main/resources/application-local.properties`.
# - The Vite frontend reads `VITE_API_BASE_URL` from `Frontend/.env`.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend: JWT Configuration (Required)
# ------------------------------------------------------------------------------
# Use a cryptographically random secret of at least 256 bits (32+ characters).
# Example generation: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_A_SECURE_RANDOM_SECRET
JWT_EXPIRATION=3600000

# ------------------------------------------------------------------------------
# Backend: PostgreSQL Configuration (Required)
# ------------------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/kishi
DB_USERNAME=YOUR_DATABASE_USERNAME
DB_PASSWORD=YOUR_DATABASE_PASSWORD

# ------------------------------------------------------------------------------
# Frontend: API Base URL (Optional; defaults to http://localhost:8080)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080

